# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Perfil persistente do Chrome em dev (mantém sessão do Firebase Auth)
.dev-chrome/

# Cache local de deploy do Firebase Hosting
.firebase/

# Artefatos locais (planos, arquivos de trabalho temporários)
temp/

# Configuração local por máquina
.env

# PocketBase local (binário e banco descartável)
tool/.bin/
.pb/

# PocketBase: only migrations are versioned
pocketbase/*
!pocketbase/pb_migrations/
# Build-time config: only the examples are versioned
config/*.json
!config/*.json.example
# wrangler cache
.wrangler/
